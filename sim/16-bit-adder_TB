//// WITH CLK
module tb;
reg [15:0] A, B; reg CIN;
wire [15:0] SUM; wire COUT;
add16 DUT (.A(A), .B(B), .CIN(CIN), .SUM(SUM), .COUT(COUT));
reg [16:0] expected;
reg error;
integer i;
reg clk;

initial begin
    clk = 0;
    $dumpfile ("add16.vcd");
    $dumpvars (0, tb);
    $monitor ("time=%0t A=%b B=%b CIN=%b SUM=%b COUT=%b", $time, A, B, CIN, SUM, COUT);
    #5 A = 16'b0000111100000001; B = 16'b0011010000000010; CIN = 1'b0;
    #10 A = 16'b0000000000001011; B = 16'b0001100000001111; CIN = 1'b1;
    #10 A = 16'b1111111111111111; B = 16'b0000000000111100; CIN = 1'b1;
    #10 A = 16'b1100000011001010; B = 16'b0000000000111111; CIN = 1'b0;
    #10 $finish;
end

always #5 clk = ~clk;

always @(posedge clk)
begin
    expected = A + B + CIN;
    error = 0;
        if ({COUT, SUM} != expected)begin
            $display ("Mismatch at %0t for A=%0b, B=%0b", $time, A, B);
            error = error + 1;
        end else begin
            $display ("All good at %0t", $time);
            error = error;
        end
    end

endmodule


